# Configuration JuriGraph
# Copiez ce fichier en '.env' puis complétez les valeurs localement.
# Ne versionnez jamais '.env' ni une clé API.

# --- Connexion Neo4j ---
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=
NEO4J_DATABASE=neo4j

# --- Embeddings ---
EMBEDDING_PROVIDER=
EMBEDDING_MODEL=
EMBEDDING_DIM=
GEMINI_API_KEY=
OPENROUTER_API_KEY=

# --- Modèle de langage (extraction / qualification) ---
LLM_PROVIDER=
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
