# Configuration des clés et accès API / Base de données
# Copiez ce fichier en '.env' et complétez avec vos identifiants :
# cp .env.example .env

# ---------------------------------------------------------------------------
# Modèle d'embeddings (voir embeddings/)
# ---------------------------------------------------------------------------
# gemini (défaut), openrouter, ou openai (tout serveur compatible /v1/embeddings :
# Ollama, vLLM, LM Studio, OpenAI, Mistral...)
EMBEDDING_PROVIDER=gemini
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIM=768
# EMBEDDING_BATCH_SIZE=20

# Clé API Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=votre_cle_gemini_ici

# --- Exemple avec un serveur local (Ollama) : ---
# EMBEDDING_PROVIDER=openai
# EMBEDDING_MODEL=nomic-embed-text
# EMBEDDING_DIM=768
# EMBEDDING_BASE_URL=http://localhost:11434/v1
# OPENAI_API_KEY=            # vide pour Ollama, requis pour OpenAI/Mistral

# --- Exemple avec OpenRouter (https://openrouter.ai/keys) : ---
# EMBEDDING_PROVIDER=openrouter
# OPENROUTER_API_KEY=sk-or-v1-...
# EMBEDDING_MODEL=openai/text-embedding-3-small
# EMBEDDING_DIM=1536
# OPENROUTER_SITE_URL=https://github.com/sandjonyves/JuriGraph   # optionnel
# OPENROUTER_APP_NAME=JuriGraph                                  # optionnel
# OPENROUTER_DIMENSIONS=0    # 1 = demander une réduction de dimension au modèle
# OPENROUTER_INPUT_TYPE=0    # 1 = envoyer search_document / search_query
# --- ou, gratuit : ---
# EMBEDDING_MODEL=nvidia/nemotron-3.5-embed-1b:free
# EMBEDDING_DIM=2048

# Paramètres de connexion Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=votre_mot_de_passe_neo4j
NEO4J_DATABASE=neo4j
# NEO4J_VECTOR_INDEX=article_embedding
