# Configuration des clés et accès API / Base de données
# Copiez ce fichier en '.env' et complétez avec vos identifiants :
# cp .env.example .env

# Clé API Google Gemini (https://aistudio.google.com/apikey)
GEMINI_API_KEY=votre_cle_gemini_ici

# Paramètres de connexion Neo4j
NEO4J_URI=bolt://localhost:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=votre_mot_de_passe_ici
NEO4J_DATABASE=neo4j
